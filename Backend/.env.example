# Carpeta con data.json y data_YYYY-MM.json. Por defecto es la misma que sirve
# el tablero (../dashboard/public), para que chat y mapa lean lo mismo.
# DATA_DIR=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI
OPENAI_API_KEY=
